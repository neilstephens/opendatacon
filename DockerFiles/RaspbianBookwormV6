# syntax=docker/dockerfile:1.2
   
FROM 2000cubits/raspbian:bookworm as builder

ARG QEMU_CPU=arm1176
ENV QEMU_CPU=${QEMU_CPU}

RUN apt-get update
RUN apt-get install -y clang libc++-dev libc++abi-dev make cmake git libmodbus-dev libc6-dev openssl libssl-dev python3 python3-dev wget

# Raspbian Bookworm ships golang-go 1.19 which is older than go.mod's
# minimum of 1.21.  Download the official ARMv6 binary directly.
ARG GO_VERSION=1.22.5
RUN wget -q https://go.dev/dl/go${GO_VERSION}.linux-armv6l.tar.gz && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-armv6l.tar.gz && \
    rm go${GO_VERSION}.linux-armv6l.tar.gz
ENV PATH="${PATH}:/usr/local/go/bin"

RUN update-alternatives --set c++ /usr/bin/clang++
RUN update-alternatives --set cc /usr/bin/clang

RUN git clone --recurse-submodules https://github.com/neilstephens/opendatacon.git
ARG BUILD_COMMIT=develop
RUN git -C opendatacon checkout $BUILD_COMMIT
RUN git -C opendatacon submodule update --recursive

ARG BUILD_TYPE=Release
ARG CMAKE_OPTIONS=

RUN mkdir opendatacon-build

RUN cmake -DFULL=ON -DCMAKE_BUILD_TYPE=$BUILD_TYPE $CMAKE_OPTIONS \
          -DCMAKE_SYSTEM_VERSION=RaspbianBookworm \
          -DCMAKE_C_FLAGS="-target arm-linux-gnueabihf -march=armv6 -mcpu=arm1176jzf-s -mfpu=vfp -mfloat-abi=hard" \
          -DCMAKE_CXX_FLAGS="-target arm-linux-gnueabihf -march=armv6 -mcpu=arm1176jzf-s -mfpu=vfp -mfloat-abi=hard" \
          -S opendatacon -B opendatacon-build
RUN cmake --build opendatacon-build --parallel 8
RUN cmake --build opendatacon-build --target install
RUN cmake --build opendatacon-build --target package

FROM scratch AS export-stage
COPY --from=builder opendatacon-build/opendatacon*.sh /
